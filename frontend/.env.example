# =============================================================================
# Frontend Environment Variables — Copy to .env.local and fill in values.
# =============================================================================

# -----------------------------------------------------------------------------
# Razorpay Test Mode Credentials (Fintech & Agentic Commerce Gateway)
# Obtain from https://dashboard.razorpay.com/#/app/keys in TEST MODE
# -----------------------------------------------------------------------------
NEXT_PUBLIC_RAZORPAY_KEY_ID=rzp_test_your_key_id_here
RAZORPAY_KEY_ID=rzp_test_your_key_id_here
RAZORPAY_KEY_SECRET=your_razorpay_key_secret_here
RAZORPAY_WEBHOOK_SECRET=your_razorpay_webhook_secret_here

# -----------------------------------------------------------------------------
# LiveKit (Real-time transport — match your backend agent's LiveKit project)
# Get these from https://cloud.livekit.io/ → your project → Settings
# -----------------------------------------------------------------------------
LIVEKIT_URL=wss://your-project.livekit.cloud
LIVEKIT_API_KEY=your_livekit_api_key_here
LIVEKIT_API_SECRET=your_livekit_api_secret_here

# -----------------------------------------------------------------------------
# Agent dispatch (optional)
# Leave blank for automatic dispatch; set to agent name for explicit dispatch.
# -----------------------------------------------------------------------------
AGENT_NAME=

# -----------------------------------------------------------------------------
# Optional — LiveKit Cloud Sandbox / custom app config
# -----------------------------------------------------------------------------
# NEXT_PUBLIC_APP_CONFIG_ENDPOINT=
# SANDBOX_ID=
